<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_staff_joining_application_list" model="ir.ui.view">
        <field name="name">staff.joining.application.list</field>
        <field name="model">staff.joining.application</field>
        <field name="arch" type="xml">
            <list string="Joining Applications"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'under_review'">
                <field name="name"/>
                <field name="full_name"/>
                <field name="job_position_id" string="Designation"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="location"/>
                <field name="create_date" string="Applied On"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'under_review'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_staff_joining_application_form" model="ir.ui.view">
        <field name="name">staff.joining.application.form</field>
        <field name="model">staff.joining.application</field>
        <field name="arch" type="xml">
            <form string="Joining Application">
                <header>
                    <button name="action_set_under_review" string="Set Under Review"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve &amp; Create Employee"
                            type="object" class="btn-success"
                            invisible="state != 'under_review'"
                            groups="base.group_system,hr.group_hr_manager,staff_joining_19.group_staff_joining_admin_approver"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="state in ('approved','rejected')"
                            groups="base.group_system,hr.group_hr_manager,staff_joining_19.group_staff_joining_admin_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employee" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not employee_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Employee</span>
                            </div>
                        </button>
                    </div>

                    <field name="photo" widget="image" class="oe_avatar"
                           options="{'preview_image': 'photo', 'size': [128, 128]}"/>

                    <div class="oe_title">
                        <h1><field name="full_name" placeholder="Full Name"/></h1>
                        <h4 class="text-muted"><field name="name" readonly="1"/></h4>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="full_name" required="1"/>
                            <field name="email" required="1" widget="email"/>
                            <field name="phone" required="1" widget="phone"/>
                            <field name="location"/>
                            <field name="job_position_id" string="Designation"/>
                        </group>
                        <group string="Identity Proof">
                            <field name="aadhaar_number" required="1"/>
                            <field name="aadhaar_doc" widget="binary" filename="aadhaar_doc_filename"/>
                            <field name="aadhaar_doc_filename" invisible="1"/>
                        </group>
                    </group>

                    <group string="Address">
                        <field name="address" required="1" nolabel="1" colspan="2"/>
                    </group>

                    <notebook>

                        <!-- DOCUMENTS TAB -->
                        <page string="Documents" name="documents">
                            <group string="Joining Documents (Required)">
                                <group>
                                    <field name="signed_nda" widget="binary" filename="signed_nda_filename" string="Signed NDA *"/>
                                    <field name="signed_nda_filename" invisible="1"/>
                                    <field name="signed_offer_letter" widget="binary" filename="signed_offer_letter_filename" string="Signed Offer Letter *"/>
                                    <field name="signed_offer_letter_filename" invisible="1"/>
                                    <field name="pan_card" widget="binary" filename="pan_card_filename" string="PAN Card *"/>
                                    <field name="pan_card_filename" invisible="1"/>
                                </group>
                            </group>
                            <group string="Educational Certificates">
                                <group>
                                    <field name="sslc_certificate" widget="binary" filename="sslc_certificate_filename" string="SSLC Certificate"/>
                                    <field name="sslc_certificate_filename" invisible="1"/>
                                    <field name="plus_two_certificate" widget="binary" filename="plus_two_certificate_filename" string="Plus Two Certificate"/>
                                    <field name="plus_two_certificate_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="degree_certificate" widget="binary" filename="degree_certificate_filename" string="Degree Certificate"/>
                                    <field name="degree_certificate_filename" invisible="1"/>
                                    <field name="other_edu_certificates" widget="binary" filename="other_edu_certificates_filename" string="Other (PG / Diploma)"/>
                                    <field name="other_edu_certificates_filename" invisible="1"/>
                                </group>
                            </group>
                            <group string="Experience &amp; Financial Documents">
                                <group>
                                    <field name="exp_relieving_letter" widget="binary" filename="exp_relieving_letter_filename" string="Exp / Relieving Letter"/>
                                    <field name="exp_relieving_letter_filename" invisible="1"/>
                                    <field name="bank_statements" widget="binary" filename="bank_statements_filename" string="Bank Statements (6 Months)"/>
                                    <field name="bank_statements_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="payslips" widget="binary" filename="payslips_filename" string="Payslips (3 Months)"/>
                                    <field name="payslips_filename" invisible="1"/>
                                    <field name="resume" widget="binary" filename="resume_filename" string="Resume (2 References)"/>
                                    <field name="resume_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- BANK TAB -->
                        <page string="Bank / Account Details" name="bank_details">
                            <group>
                                <group>
                                    <field name="bank_account_name"/>
                                    <field name="bank_account_number"/>
                                </group>
                                <group>
                                    <field name="bank_name"/>
                                    <field name="bank_ifsc"/>
                                    <field name="bank_branch"/>
                                </group>
                            </group>
                        </page>

                        <!-- APPROVAL TAB -->
                        <page string="Approval Info" name="approval_info" invisible="state == 'draft'">
                            <group>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                            </group>
                            <group invisible="state != 'rejected'">
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_staff_joining_application_kanban" model="ir.ui.view">
        <field name="name">staff.joining.application.kanban</field>
        <field name="model">staff.joining.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="full_name"/><field name="email"/><field name="phone"/>
                <field name="state"/><field name="photo"/><field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <img t-att-src="kanban_image('staff.joining.application','photo',record.id.raw_value)"
                                     class="rounded-circle me-2"
                                     style="width:40px;height:40px;object-fit:cover;" alt="Photo"/>
                                <div>
                                    <strong><field name="full_name"/></strong><br/>
                                    <small class="text-muted"><field name="email"/></small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <small><i class="fa fa-phone me-1"/><field name="phone"/></small>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-warning="state == 'under_review'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_staff_joining_application_search" model="ir.ui.view">
        <field name="name">staff.joining.application.search</field>
        <field name="model">staff.joining.application</field>
        <field name="arch" type="xml">
            <search string="Search Applications">
                <field name="full_name"/><field name="email"/>
                <field name="phone"/><field name="aadhaar_number"/>
                <separator/>
                <filter string="Submitted"    name="draft"        domain="[('state','=','draft')]"/>
                <filter string="Under Review" name="under_review" domain="[('state','=','under_review')]"/>
                <filter string="Approved"     name="approved"     domain="[('state','=','approved')]"/>
                <filter string="Rejected"     name="rejected"     domain="[('state','=','rejected')]"/>
                <group>
                    <filter string="Status"       name="group_state"    context="{'group_by':'state'}"/>
                    <filter string="Location"     name="group_location" context="{'group_by':'location'}"/>
                    <filter string="Applied Month" name="group_month"   context="{'group_by':'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_staff_joining_application" model="ir.actions.act_window">
        <field name="name">Joining Applications</field>
        <field name="res_model">staff.joining.application</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_staff_joining_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No joining applications yet!</p>
            <p>Share the portal link with candidates so they can submit their joining applications.</p>
        </field>
    </record>

    <!-- APPROVE WIZARD -->
    <record id="view_staff_joining_approve_wizard" model="ir.ui.view">
        <field name="name">staff.joining.approve.wizard.form</field>
        <field name="model">staff.joining.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Employee Login">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Approving: </strong><field name="applicant_name" readonly="1" nolabel="1"/>
                        <br/><strong>Email: </strong><field name="applicant_email" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Set Login Credentials">
                        <field name="application_id" invisible="1"/>
                        <field name="login" required="1"/>
                        <field name="password" required="1" password="True"/>
                        <field name="confirm_password" required="1" password="True"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        An Employee record and Internal User login will be created. Share credentials securely.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_approve" string="Confirm &amp; Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- REJECT WIZARD -->
    <record id="view_staff_joining_reject_wizard" model="ir.ui.view">
        <field name="name">staff.joining.reject.wizard.form</field>
        <field name="model">staff.joining.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Application">
                <sheet>
                    <group>
                        <field name="application_id" invisible="1"/>
                        <field name="rejection_reason" required="1" placeholder="Reason for rejection..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
